{
  "name": "tubes-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:coverage:all": "vitest run --coverage",
    "test:coverage:gate": "vitest run --coverage --config vitest.gate.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "build:visual": "vite build --mode visual --outDir dist-visual --emptyOutDir",
    "test:visual": "npm run build:visual && npm run build-storybook && strata-visual",
    "test:visual:update": "npm run build:visual && npm run build-storybook && strata-visual --update",
    "api-types": "strata-api-types openapi.json -o src/api.generated.ts",
    "api-types:check": "strata-api-types openapi.json -o src/api.generated.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@tanstack/react-query": "^5.108.3",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "strata-react": "^2.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.65.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
